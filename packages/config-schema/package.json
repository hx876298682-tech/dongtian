{
  "name": "@dongtian/config-schema",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "exports": {
    ".": {
      "types": "./src/index.ts",
      "import": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "config:build": "pnpm build",
    "config:validate": "pnpm build && node dist/validate.js",
    "typecheck": "tsc --noEmit -p tsconfig.json"
  },
  "devDependencies": {
    "@types/node": "24.13.3"
  },
  "dependencies": {
    "zod": "4.4.3"
  }
}
