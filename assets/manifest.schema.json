{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dongtian.local/assets/manifest.schema.json",
  "title": "Dongtian Asset Manifest",
  "type": "object",
  "additionalProperties": false,
  "required": ["manifest_version", "config_version", "locale", "localization_path", "entries"],
  "properties": {
    "manifest_version": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d{2}\\.\\d+\\.\\d+$"
    },
    "config_version": {
      "type": "string",
      "pattern": "^\\d{4}\\.\\d{2}\\.\\d+\\.\\d+$"
    },
    "locale": {
      "type": "string",
      "pattern": "^[a-z]{2}-[A-Z]{2}$"
    },
    "localization_path": {
      "type": "string",
      "pattern": "^[a-z0-9_.\\-/]+\\.json$"
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/entry"
      }
    }
  },
  "$defs": {
    "entry": {
      "type": "object",
      "additionalProperties": false,
      "required": ["content_id", "kind", "scope", "name_key", "description_key", "resource"],
      "properties": {
        "content_id": {
          "type": "string",
          "pattern": "^[a-z0-9_]+(?:\\.[a-z0-9_]+)+$"
        },
        "kind": {
          "type": "string",
          "enum": [
            "region_background",
            "equipment_icon",
            "material_icon",
            "status_icon",
            "base_audio"
          ]
        },
        "scope": {
          "type": "string",
          "enum": ["P0", "ANCHOR"]
        },
        "name_key": {
          "type": "string",
          "pattern": "^[a-z0-9_]+(?:\\.[a-z0-9_]+)+$"
        },
        "description_key": {
          "type": "string",
          "pattern": "^[a-z0-9_]+(?:\\.[a-z0-9_]+)+$"
        },
        "resource": {
          "$ref": "#/$defs/resource"
        }
      }
    },
    "resource": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "relative_path",
        "file_name",
        "media_type",
        "format",
        "placeholder",
        "placeholder_reason",
        "copyright_source"
      ],
      "properties": {
        "relative_path": {
          "type": "string",
          "pattern": "^[a-z0-9_.\\-/]+$"
        },
        "file_name": {
          "type": "string",
          "pattern": "^[a-z0-9_]+(?:_[a-z0-9]+)*\\.(svg|png|webp|wav|ogg|mp3)$"
        },
        "media_type": {
          "type": "string",
          "enum": ["image", "audio"]
        },
        "format": {
          "type": "string",
          "enum": ["svg", "png", "webp", "wav", "ogg", "mp3"]
        },
        "width": {
          "type": "integer",
          "minimum": 1
        },
        "height": {
          "type": "integer",
          "minimum": 1
        },
        "duration_ms": {
          "type": "integer",
          "minimum": 1
        },
        "placeholder": {
          "type": "boolean"
        },
        "placeholder_reason": {
          "type": "string",
          "minLength": 1
        },
        "copyright_source": {
          "type": "string",
          "minLength": 1
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "media_type": {
                "const": "image"
              }
            },
            "required": ["media_type"]
          },
          "then": {
            "required": ["width", "height"]
          }
        },
        {
          "if": {
            "properties": {
              "media_type": {
                "const": "audio"
              }
            },
            "required": ["media_type"]
          },
          "then": {
            "required": ["duration_ms"]
          }
        }
      ]
    }
  }
}
